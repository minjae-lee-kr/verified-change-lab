{
  "name": "verified-change-lab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "experiment": "node src/experiment.ts",
    "state:experiment": "node src/state-envelope-experiment.ts",
    "lab": "node src/cli.ts",
    "serve": "node src/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "prettier --check . && tsc --noEmit && node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
